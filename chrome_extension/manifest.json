{
  "manifest_version": 3,
  "name": "DA C3 Kat - Homeschool Extension",
  "version": "1.0",
  "description": "Tiện ích mở rộng hỗ trợ học tập Khan Academy và ghi chú cho Kat",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.khanacademy.org/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.khanacademy.org/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kat's Study Tools"
  }
}
